{
  "name": "rescify",
  "version": "1.0.0",
  "description": "Rescify — Civic Emergency & Shelter Command Center (CAK3EAB3)",
  "main": "dist/server/server/index.js",
  "scripts": {
    "dev": "ts-node -P tsconfig.server.json src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node dist/server/server/index.js",
    "test": "node -e \"process.env.TS_NODE_PROJECT='tsconfig.server.json'; process.env.NODE_ENV='test'; require('child_process').execFileSync(process.execPath, ['--test', '-r', 'ts-node/register', 'tests/api.test.ts'], { stdio: 'inherit' })\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
